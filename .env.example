# Borgo Batone Signal Bot - Environment Variables
# Kopiere diese Datei nach .env und passe die Werte an

# Signal Account (Telefonnummer des Bots)
SIGNAL_ACCOUNT=+49XXXXXXXXXXX

# Signal Gruppen-IDs (aus: signal-cli -a <NUMMER> listGroups)
SIGNAL_GROUP_DEV=<dev-group-id-hier-eintragen>
SIGNAL_GROUP_TEST=<test-group-id-hier-eintragen>
SIGNAL_GROUP_COMMUNITY=<community-group-id-hier-eintragen>

# Ollama URL
OLLAMA_URL=http://localhost:11434

# Logging Level (DEBUG | INFO | WARNING)
LOG_LEVEL=INFO
